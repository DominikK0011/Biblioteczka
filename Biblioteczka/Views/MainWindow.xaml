<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Biblioteczka.UI.MainWindow"
        Title="{Binding Title}" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <Border Background="#161625">
            <StackPanel Margin="15">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                    <materialDesign:PackIcon Kind="MovieOpen" Width="30" Height="30" Foreground="DarkOrange" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Biblioteczka" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="MainPageButton" Command="{Binding LoadHomeCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{Binding HomeTextColour}" HorizontalContentAlignment="Left" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Home" Margin="0,0,10,0"/>
                        <TextBlock Text="Strona główna"/>
                    </StackPanel>
                </Button>
                <Button x:Name="MovieButton" Command="{Binding LoadMoviesCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{Binding MovieTextColour}" HorizontalContentAlignment="Left" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Filmstrip" Margin="0,0,10,0"/>
                        <TextBlock Text="Filmy"/>
                    </StackPanel>
                </Button>
                <Button x:Name="FavoritesButton" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{Binding FavoritiesTextColour}" HorizontalContentAlignment="Left" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Heart" Margin="0,0,10,0"/>
                        <TextBlock Text="Ulubione"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ReviewButton" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{Binding ReviewsTextColour}" HorizontalContentAlignment="Left" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Star" Margin="0,0,10,0"/>
                        <TextBlock Text="Recenzje"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ProfileButton" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{Binding ProfileTextColour}" HorizontalContentAlignment="Left" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Account" Margin="0,0,10,0"/>
                        <TextBlock Text="Profil"/>
                    </StackPanel>
                </Button>

                <Button x:Name="LogoutButton" Style="{StaticResource MaterialDesignFlatButton}" Foreground="Gray" HorizontalContentAlignment="Left" VerticalAlignment="Bottom" Margin="0,10,0,0"
                        Command="{Binding LogoutCommand}" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Logout" Margin="0,0,10,0"/>
                        <TextBlock Text="Wyloguj"/>
                    </StackPanel>
                </Button>
                <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Margin="0,200,0,30" >
                    <materialDesign:PackIcon Width="28" Height="28" Kind="AccountHardHat" Foreground="Orange"/>
                    <TextBlock FontSize="18" VerticalAlignment="Center" Foreground="Orange" FontWeight="Bold">Admin Panel</TextBlock>
                    </StackPanel>
                    <Button x:Name="AddMovie" Command="{Binding AddMovie}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="Orange">Add Movie</Button>
                    <Button x:Name="AddActor" Style="{StaticResource MaterialDesignFlatButton}" Foreground="Orange">Add Actor</Button>
                    <Button x:Name="AddDirector" Style="{StaticResource MaterialDesignFlatButton}" Foreground="Orange">Add Director</Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,20">
                <TextBox materialDesign:HintAssist.Hint="Szukaj filmów, reżyserów, aktorów..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Width="400" HorizontalAlignment="Left"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Magnify"/>
            </Grid>

            <ScrollViewer x:Name="MainPage" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Border Background="#252538" CornerRadius="10" Height="200" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="★ Polecany film" Foreground="DarkOrange" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="Incepcja" FontSize="26" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Dom Cobb jest nieuchwytnym złodziejem..." Foreground="Gray" TextWrapping="Wrap" MaxWidth="400" Margin="0,5,0,15"/>
                                <Button Content="Zobacz więcej" Style="{StaticResource MaterialDesignRaisedButton}" Width="130" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Polecane filmy" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox ItemsSource="{Binding Movies}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"/>
                                    <TextBlock Text="{Binding Description}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="MoviePage" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsMoviePage, Converter={StaticResource BoolToVisibilityConverter}}" d:IsHidden="True">
                <StackPanel>
                    <ListBox ItemsSource="{Binding Movies}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="160" ItemHeight="240"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="8" Background="#1e1e1e" CornerRadius="6"
                                        BorderBrush="#333" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Image Source="{Binding PosterUrl}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Grid.Row="0"/>
                                        <TextBlock Text="{Binding Title}" Grid.Row="1" Foreground="White" TextAlignment="Center" FontWeight="Bold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="2" Background="#161625" Padding="15">
            <StackPanel>
                <StackPanel x:Name="PanelZalogowanego" Orientation="Horizontal"
                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}" >
                    <materialDesign:PackIcon Kind="BellOutline" Width="22" Height="22" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand"/>
                    <Button Command="{Binding ChangeAvatarCommand}" Background="Transparent" Padding="0" BorderThickness="0">
                        <Ellipse Width="32" Height="32" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding UserAvatarUrl}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Button>
                    <TextBlock x:Name="UsernameTextBlock" 
                               Text="{Binding Username}" 
                               Foreground="White" 
                               VerticalAlignment="Center" 
                               FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsLoggedOut, Converter={StaticResource BoolToVisibilityConverter}}" d:IsHidden="True">
                    <Button x:Name="BtnZaloguj" Content="Zaloguj się"
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Foreground="DarkOrange"
                        FontWeight="Bold" 
                        Cursor="Hand"
                        Command="{Binding ShowLoginWindowCommand}"    />
                </StackPanel>
                <TextBlock Text="Moje statystyki" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Border Background="#1E1E30" CornerRadius="8" Padding="12" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="🎬 Obejrzane filmy: 12" Foreground="#DDDDDD" Margin="0,0,0,8"/>
                        <TextBlock Text="❤️ Ulubione filmy: 8" Foreground="#DDDDDD" Margin="0,0,0,8"/>
                        <TextBlock Text="⭐ Napisane recenzje: 5" Foreground="#DDDDDD"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Ostatnie aktywności" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="• Dodałeś recenzję do Incepcja" FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="• Oglądałeś film Interstellar" FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>